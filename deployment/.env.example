APP_ENV=production
DATA_MODE=REAL
# Optional local Docker override. Hosted container platforms normally inject it.
# PORT=8010

# Python/FastAPI reference implementation only. Leave provider, endpoint, and
# key empty to use deterministic grounded fallback without an external call.
HEATSAFE_AGENT_PROVIDER=
HEATSAFE_AGENT_BASE_URL=
HEATSAFE_AGENT_API_KEY=
HEATSAFE_AGENT_MODEL=glm-5.3-flash
HEATSAFE_AGENT_THINKING=
HEATSAFE_AGENT_TIMEOUT_SECONDS=60
HEATSAFE_AGENT_MAX_OUTPUT_TOKENS=4096
HEATSAFE_AGENT_MAX_TOOL_STEPS=4
HEATSAFE_AGENT_MAX_CONCURRENT=4

# Set to the trusted reverse-proxy address range. Use * only when the container
# cannot be reached directly and every request is guaranteed to cross the proxy.
FORWARDED_ALLOW_IPS=127.0.0.1
